rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'CEO' || 
         (request.auth.token.email == 'assessoriaomega1@gmail.com' && request.auth.token.email_verified == true));
    }
    
    function isActive() {
      return isAuthenticated() && getUserData().isActive == true;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    match /state/global {
      allow read: if isActive();
      allow write: if isActive();
    }

    match /activity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
